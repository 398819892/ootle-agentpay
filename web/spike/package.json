{
  "name": "agentpay-wallet-spike",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Spike: AgentBudget open/pay signed by the user's own key (browser SecretKeyWallet, walletd signing requests, or the user's own wallet via window.tari) through ootle.ts, submitted through the indexer. Upgraded to the Ootle 0.50.1 package set (ootle.ts 0.14, wasm 0.50.1) for esmeralda; flow A/B were proven on the 0.47 local swarm.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "flow:a": "node --experimental-wasm-modules node/flow-a-browser-key.mjs",
    "flow:a:dry": "node --experimental-wasm-modules node/flow-a-browser-key.mjs --dry-run",
    "flow:b": "node --experimental-wasm-modules node/flow-b-walletd-approve.mjs",
    "smoke:esme": "node --experimental-wasm-modules node/smoke-esmeralda.mjs",
    "mock:tari": "node --experimental-wasm-modules node/mock-window-tari.mjs",
    "test": "node --test node/*.test.mjs"
  },
  "dependencies": {
    "@tari-project/ootle": "0.14.0",
    "@tari-project/ootle-indexer": "0.14.0",
    "@tari-project/ootle-secret-key-wallet": "0.14.0",
    "@tari-project/ootle-wallet-daemon-signer": "0.14.0",
    "@tari-project/ootle-wasm-bor": "0.50.1"
  },
  "devDependencies": {
    "vite": "^6.4.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
