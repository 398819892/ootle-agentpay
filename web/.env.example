# Copy to web/.env and fill in. NEVER commit the real web/.env (it is git-ignored).

# --- dashboard auth (REQUIRED for any non-localhost deployment) ---
# The password users type to sign in. Use a long, random value.
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# Secret that signs session cookies. Generate one, e.g.:  openssl rand -hex 32
# Keep it stable so sessions survive restarts (and are shared across replicas).
SESSION_SECRET=change-me-openssl-rand-hex-32

# Admin secret for the STEP-UP confirmation on high-risk actions (withdraw, revoke, change
# whitelist, mint/revoke a badge, freeze/unfreeze, reset). Keep it DIFFERENT from DASHBOARD_PASSWORD
# so that "can operate/read" is not the same as "can move funds". If unset, step-up falls back to
# DASHBOARD_PASSWORD. See docs/custody.md.
AGENTPAY_ADMIN_PASSWORD=change-me-to-a-different-long-random-password

# --- walletd keyring ---
# The passphrase that unlocks the wallet daemon's keyring. Keep it out of logs and images.
WALLETD_KEYRING_PASSWORD=change-me

# --- account isolation (recommended for anything non-local) ---
# Use a DEDICATED owner/treasury account, NOT the wallet's "default" account, so the dashboard's
# blast radius is one purpose-built account. Fund it with only what the agent needs near-term.
# AGENTPAY_OWNER_ACCOUNT=agentpay-treasury
# Never let a public deployment mint/fund merchant accounts on demand (default off when auth is on):
# AGENTPAY_AUTO_CREATE_MERCHANTS=false

# --- machine-to-machine integration API (/api/v1) ---
# Bearer API keys for third-party / agent callers of the hosted API (independent of the browser
# login). OFF unless set. Comma- or newline-separated, each "role:id:secret": role is agent|admin,
# id is a short non-secret label (shown in the audit log), secret is the bearer value (>=16 chars;
# generate with: openssl rand -hex 24). Agent keys can pay + read; admin keys can also open budgets,
# register merchants and read the audit log. Revocation persists in the state file. See docs/api.md.
# AGENTPAY_API_KEYS=agent:bot1:sk_agent_REPLACE_WITH_RANDOM, admin:ops:sk_admin_REPLACE_WITH_RANDOM

# --- audit log ---
# Append-only JSONL of every state-changing call. Mount this on a volume; ship it off-box to an
# append-only sink in production (the local file is not tamper-proof). See docs/custody.md.
# AGENTPAY_AUDIT_FILE=/data/audit.log

# --- state + transaction journal ---
# The chain is the authority for balances; these files are only a reference/config snapshot and an
# operation journal (pending→confirmed|rejected|unknown, idempotency, reconciled on startup). Both
# are written atomically. Mount them on a persistent volume. See docs/custody.md §4.
# AGENTPAY_STATE_FILE=/data/state.json
# AGENTPAY_TXLOG_FILE=/data/txlog.json
# Confirmation window a money op waits before a tx is recorded 'unknown' (reconciled later, never
# counted as success): TRIES × DELAY_MS. Defaults 40 × 1500ms = 60s.
# AGENTPAY_FINALIZE_TRIES=40
# AGENTPAY_FINALIZE_DELAY_MS=1500

# --- web-security boundary (CSRF / origin / trusted proxy) ---
# When DASHBOARD_PASSWORD is set, every state-changing POST must (a) pass an Origin/Referer check and
# (b) carry the per-session X-CSRF-Token the SPA gets from /api/login or /api/session. No config needed
# for the common single-origin deploy. See docs/security.md "Web-security boundary".
#
# Behind a reverse proxy / load balancer, tell the app how to find the REAL client IP for the login +
# operation throttles. By default X-Forwarded-For is IGNORED (so a forged XFF can't dodge the per-IP
# lockout); the socket peer is used. Set ONE of:
#   TRUSTED_PROXY=true            # single trusted hop: take the left-most X-Forwarded-For entry
#   TRUSTED_PROXY=10.0.0.1,10.0.0.2   # trust XFF only when the direct peer is one of these proxy IPs
# TRUSTED_PROXY=
# Extra browser-facing origins to allow for the CSRF origin check (comma-separated full origins). The
# request's own Host is always allowed; set this only if the public origin differs from the Host the
# app sees. e.g. ALLOWED_ORIGINS=https://pay.example.com
# ALLOWED_ORIGINS=

# --- optional ---
# SESSION_TTL_HOURS=12
# The login throttle, operation rate limiter and logout token-revocation are IN-MEMORY and
# single-instance (testnet assumption): they reset on restart and do not span replicas. For a
# multi-instance deploy, enforce rate limits at the proxy/WAF and use a shared session store. See
# docs/security.md "Operational assumptions".
# LOGIN_MAX_FAILS=8
# LOGIN_LOCK_MINUTES=10
# CONFIRM_TTL_SECONDS=120          # how long a step-up confirm token is valid (single-use)
# --- fund-movement rate limit + anomaly flags (separate from the login throttle) ---
# AGENTPAY_RATE_MAX=40             # all state-changing ops / window, per actor
# AGENTPAY_RATE_WINDOW_MS=60000
# AGENTPAY_MONEY_MAX=12            # stricter cap on money-moving ops (pay/top-up/withdraw/fund)
# AGENTPAY_MONEY_WINDOW_MS=60000
# AGENTPAY_ANOMALY_AMOUNT=0        # >0 flags (does not block) a single amount at/above this (base units)
# AGENTPAY_BURST_N=5               # flag this many money ops within AGENTPAY_BURST_MS
# AGENTPAY_BURST_MS=10000
