# Copy to web/.env and fill in. NEVER commit the real web/.env (it is git-ignored).

# --- dashboard auth (REQUIRED for any non-localhost deployment) ---
# The password users type to sign in. Use a long, random value.
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# Secret that signs session cookies. Generate one, e.g.:  openssl rand -hex 32
# Keep it stable so sessions survive restarts (and are shared across replicas).
SESSION_SECRET=change-me-openssl-rand-hex-32

# --- walletd keyring ---
# The passphrase that unlocks the wallet daemon's keyring. Keep it out of logs and images.
WALLETD_KEYRING_PASSWORD=change-me

# --- optional ---
# SESSION_TTL_HOURS=12
# LOGIN_MAX_FAILS=8
# LOGIN_LOCK_MINUTES=10
