# Large / re-downloadable (not source)
# node-binaries: prebuilt Tari node binaries (re-downloadable from official releases)
# wasm-template: reference clone of the official template repo (has its own .git)
node-binaries/
wasm-template/

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pnp.*
.yarn/

# Build output
target/
dist/
build/
*.wasm
.vite/
.next/
out/

# Tari / runtime state
.tari/
*.pid

# Web dashboard runtime state — holds account addresses + the operation journal; never commit it.
web/server/state.json
web/server/state.*.json
web/server/txlog.json
web/server/claims/
web/server/audit.log

# Env & secrets
.env
.env.*
!.env.example

# Logs & temp
*.log
tmp/
.cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Vendored build output — the dashboard's run.sh runs with no build step,
# so the small prebuilt TS client is committed on purpose.
!clients/ts/dist/
!clients/ts/dist/**
# …but never the compiled *test* artifacts — tests are type-checked/run from src, not shipped.
clients/ts/dist/*.test.js
clients/ts/dist/*.test.d.ts

# Archives & stray folders (not source)
*.7z
*.zip
*.rar
新建文件夹/

# Review / working documents — keep local, not in the (possibly public) repo
*.docx
*.doc
*.pdf
# …including the per-round review write-ups kept as local .md (the consolidated, committed record
# is docs/audit-notes.md). Anchored to the review-artifact name so real docs/*.md are unaffected.
/Ootle_*.md
docs/Ootle_*.md

# Claude desktop app preview launcher (machine-specific)
.claude/launch.json

# Shared AgentPay config — real deployment values (templates: agentpay.config.example.json is tracked)
agentpay.config.json

# Proprietary billing/SaaS backend - NOT under the repo's BSD-3-Clause license; keep it out of this (public) repo.
/billing/
